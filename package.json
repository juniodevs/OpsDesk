{
  "name": "opsdesk-qa-portfolio",
  "version": "1.0.0",
  "description": "OpsDesk - Incident Management Platform with Comprehensive QA Automation Suite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch app/src/server/server.ts",
    "build:client": "vite build app/src/client --outDir ../../dist/client",
    "build": "npm run build:client && tsc -p app/tsconfig.json",
    "start": "tsx app/src/server/server.ts",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
